# =============================================================================
# FinancialEventCollector — .gitignore
# Covers: .NET 8 / C#, Python / FastAPI, Visual Studio, VS Code, Windows
# =============================================================================

# -----------------------------------------------------------------------------
# .NET / C# build artifacts
# -----------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/
project.lock.json
project.fragment.lock.json
artifacts/

# MSBuild
*.binlog

# Publish output
[Pp]ublish/
PublishProfiles/*.pubxml.user

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml
*.cobertura.xml
coverage/
.msCoverageSourceRootsMapping*

# Rider / ReSharper
.idea/
*.DotSettings.user
_ReSharper*/
*.ReSharper

# -----------------------------------------------------------------------------
# Python artifacts
# -----------------------------------------------------------------------------

# Virtual environments
.venv/
venv/
env/
ENV/
.env/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST
.eggs/
wheels/
pip-wheel-metadata/
share/python-wheels/

# Testing
.pytest_cache/
.tox/
.nox/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
nosetests.xml
pytest.ini.bak

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# pyenv
.python-version

# pipenv / poetry / uv
Pipfile.lock
poetry.lock
uv.lock

# -----------------------------------------------------------------------------
# Visual Studio
# -----------------------------------------------------------------------------
.vs/
*.VC.db
*.VC.VC.opendb
*.opensdf
*.sdf
*.cachefile
*.aps
*.ncb
*.opendb
ipch/

# VS Code — exclude the whole directory, then re-include the shared extensions list
.vscode/
!.vscode/extensions.json

# -----------------------------------------------------------------------------
# Windows
# -----------------------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# -----------------------------------------------------------------------------
# macOS (for cross-platform teams)
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# -----------------------------------------------------------------------------
# Secrets / environment files
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
secrets.json
appsettings.Production.json

# -----------------------------------------------------------------------------
# Logs & temp files
# -----------------------------------------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.swp
*~

# -----------------------------------------------------------------------------
# Deployment / packaging artifacts
# -----------------------------------------------------------------------------
*.zip
*.tar.gz
*.7z
deploy-output/
publish_output/

# Batch / shell deployment scripts (may contain credentials)
*.bat
*.sh
