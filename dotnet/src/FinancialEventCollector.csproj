<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy shared data files from repo root shared/ to the output directory -->
    <Content Include="..\..\shared\config\pipeline-config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>config\pipeline-config.json</Link>
    </Content>
    <Content Include="..\..\shared\config\llm-response-schema.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>config\llm-response-schema.json</Link>
    </Content>
    <Content Include="..\..\shared\data\Incidents.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>data\Incidents.json</Link>
    </Content>
    <Content Include="..\..\shared\data\EventLogs.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>data\EventLogs.json</Link>
    </Content>
    <Content Include="..\..\shared\data\RootCauses.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>data\RootCauses.json</Link>
    </Content>
    <Content Include="..\..\shared\prompts\investigation-prompt.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>prompts\investigation-prompt.md</Link>
    </Content>
  </ItemGroup>

</Project>
